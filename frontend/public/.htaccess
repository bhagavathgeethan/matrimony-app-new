<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Don't rewrite real files or real directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Prevent infinite loops: if a static asset (js, css, fonts, images) is missing, return 404 directly
  RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot|map|json)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 3. For all client-side SPA routes, rewrite to index.html
  RewriteRule ^ index.html [L]
</IfModule>
