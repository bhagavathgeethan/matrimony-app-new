# ─────────────────────────────────────────────────────────────────────────────
# 3Knot Matrimony Backend — Production Environment
# Copy to .env and fill in the values marked with TODO
# ─────────────────────────────────────────────────────────────────────────────

PORT=5000
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# Your remote PostgreSQL (URL-encode special chars in the password, e.g. @ → %40)
DATABASE_URL=postgresql://postgres:Stu%40123@187.127.178.200:5444/ab_matrimony
# Set to true if the PostgreSQL server requires SSL connections
DATABASE_SSL=false

# ── Public URL ───────────────────────────────────────────────────────────────
# TODO: Replace with your actual domain (e.g. https://api.3knot.in)
PUBLIC_BASE_URL=https://yourdomain.com
# Comma-separated origins allowed to call the API (your web app, mobile deep links)
# TODO: Replace with your actual frontend URLs
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── Sessions ─────────────────────────────────────────────────────────────────
SESSION_TTL_DAYS=30

# ── OTP / SMS ────────────────────────────────────────────────────────────────
# TODO: Switch to a real SMS provider (e.g. 'twilio', 'msg91') before going live
SMS_PROVIDER=dummy
# NEVER echo OTP in production responses
OTP_DEV_ECHO=false
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_HOUR=5

# ── Push Notifications ──────────────────────────────────────────────────────
# TODO: Switch to 'fcm' and provide Firebase credentials for production pushes
PUSH_PROVIDER=dummy
MATCH_ALERT_THRESHOLD=80

# ── File Storage (Depot) ────────────────────────────────────────────────────
STORAGE_URL=https://depot.thestucompany.com
# TODO: Set your Depot API key (server-side only, never expose to clients)
STORAGE_API_KEY=
STORAGE_BUCKET=knotfiles
STORAGE_TIMEOUT_MS=20000

# Signing secret for private photo/media URLs. MUST be a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# TODO: Set this and keep it stable across deploys (links break if it changes)
MEDIA_URL_SECRET=

# Upload limits
MAX_UPLOAD_BYTES=5242880
MAX_PHOTOS=6
MAX_VIDEO_BYTES=2147483648

# ── DPDP Erasure ─────────────────────────────────────────────────────────────
ERASURE_DELAY_HOURS=72
ERASURE_SWEEP_MINUTES=10

# ── Safety & Limits ─────────────────────────────────────────────────────────
INTEREST_DAILY_LIMIT=10
REPORT_HIDE_THRESHOLD=3
# TODO: Comma-separated phone numbers (E.164) for admin access, e.g. +919876543210
ADMIN_PHONES=

# ── Payments ─────────────────────────────────────────────────────────────────
# TODO: Switch to 'razorpay' and set credentials before going live
PAYMENT_PROVIDER=dummy

# ── Background Jobs ─────────────────────────────────────────────────────────
JOBS_INTERVAL_MINUTES=30
DAILY_PICKS_COUNT=5
DAILY_PICKS_HOUR_IST=8
NUDGE_AFTER_HOURS=24
NUDGE_EVERY_DAYS=3

# ── Video Calls ──────────────────────────────────────────────────────────────
CALL_RING_SECONDS=30
# Optional TURN server for strict networks
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Web App ──────────────────────────────────────────────────────────────────
# Path to the built web app (relative to backend/)
WEB_DIST_DIR=../web/dist

