PORT=5000
NODE_ENV=development

# PostgreSQL connection (URL-encode special characters in the password, e.g. @ -> %40)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=true

# Public URL of this backend (used in photo links and parent-portal links)
PUBLIC_BASE_URL=http://localhost:5000
# CORS_ORIGINS=*

# Sessions
# SESSION_TTL_DAYS=30

# OTP / SMS ('dummy' logs codes to the console; OTP_DEV_ECHO returns the code in the API response outside production)
SMS_PROVIDER=dummy
# OTP_DEV_ECHO=true
# OTP_TTL_SECONDS=300
# OTP_RESEND_SECONDS=30
# OTP_MAX_ATTEMPTS=5
# OTP_MAX_PER_HOUR=5

# Push notifications ('dummy' logs pushes until Firebase Cloud Messaging is connected)
PUSH_PROVIDER=dummy
# MATCH_ALERT_THRESHOLD=80

# File storage: Depot. Everything goes in one private bucket, opened only through signed links.
# Server-side only; never expose the key.
STORAGE_URL=https://depot.thestucompany.com
STORAGE_API_KEY=
STORAGE_BUCKET=knotfiles
# STORAGE_TIMEOUT_MS=20000
# Secret for signing private photo links (long random string; keep it stable across restarts and instances)
MEDIA_URL_SECRET=
# MAX_UPLOAD_BYTES=5242880
# MAX_PHOTOS=6
# MAX_VIDEO_BYTES=2147483648

# DPDP erasure
# ERASURE_DELAY_HOURS=72
# ERASURE_SWEEP_MINUTES=10

# One-time: allow dropping the old demo tables during migration
# MIGRATE_DROP_LEGACY=true

# Legacy local upload folders, read only by scripts/migrate-local-uploads.js
# UPLOAD_DIR=uploads
# PRIVATE_UPLOAD_DIR=uploads-private
# Safety and limits
INTEREST_DAILY_LIMIT=10
REPORT_HIDE_THRESHOLD=3
# Comma-separated phone numbers (E.164) that become admins when they sign in
ADMIN_PHONES=16478901234
# Payments: 'dummy' (default in dev) or 'razorpay'
PAYMENT_PROVIDER=dummy
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# Background jobs
JOBS_INTERVAL_MINUTES=30
DAILY_PICKS_COUNT=5
DAILY_PICKS_HOUR_IST=8
NUDGE_AFTER_HOURS=24
NUDGE_EVERY_DAYS=3
# Video calls: optional TURN server for strict networks (STUN works without it)
CALL_RING_SECONDS=30
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
