# Settings for docker-compose.yml (copy to .env next to it). The app's own settings stay in backend/.env.

# Token of your Cloudflare Tunnel (Zero Trust → Networks → Tunnels → your tunnel → Install connector)
CLOUDFLARE_TUNNEL_TOKEN=

# The public address the tunnel serves, without a trailing slash
PUBLIC_BASE_URL=https://app.example.com

# Local port for checking the container directly (http://localhost:5080); not public
# APP_PORT=5080
