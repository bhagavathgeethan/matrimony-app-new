# Settings for docker-compose.yml (copy to .env next to it). The backend's own settings stay in backend/.env.

# Token of your Cloudflare Tunnel (Zero Trust → Networks → Tunnels → your tunnel → Install connector)
CLOUDFLARE_TUNNEL_TOKEN=

# Public address of the web app on Cloudflare Workers, without a trailing slash
# (e.g. https://3knot-web.<your-subdomain>.workers.dev or your own domain). Photo and family-portal links use it.
PUBLIC_BASE_URL=https://3knot.example.com

# Local ports for checking on this machine; not public
# APP_PORT=5080
# WEB_PORT=5081
